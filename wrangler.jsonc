{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memora-summary",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "MEMORA_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}

